<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Image-naamgeving: alleen het naamsdeel is statisch; host en
       namespace komen dynamisch via -p:RegistryHost/-p:RegistryNamespace
       van de workflow. Condition-defaults voor lokaal publishen. -->
  <PropertyGroup>
    <ImageShortName>learncicd-worker</ImageShortName>
    <RegistryHost Condition="'$(RegistryHost)' == ''">go.berg-connect.nl</RegistryHost>
    <RegistryNamespace Condition="'$(RegistryNamespace)' == ''">beheerder</RegistryNamespace>
    <ContainerRepository>$(RegistryHost)/$(RegistryNamespace)/$(ImageShortName)</ContainerRepository>
  </PropertyGroup>

</Project>
